{
  "name": "chalkboard",
  "version": "2.0.0",
  "description": "A real-time collaborative chalkboard: draw together in the browser over Socket.IO.",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "lint": "eslint .",
    "test": "node --test \"server/*.test.js\""
  },
  "keywords": [
    "drawing",
    "whiteboard",
    "real-time",
    "socket.io",
    "react",
    "p5js",
    "express",
    "vite"
  ],
  "author": {
    "name": "Zachariah Ayers",
    "url": "https://ayers.repair"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0"
  }
}
